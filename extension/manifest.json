{
  "manifest_version": 3,
  "name": "Netflix Discord Rich Presence",
  "version": "1.0.0",
  "description": "Displays what you are watching on Netflix in your Discord Rich Presence in real-time.",
  "icons": {
    "16": "assets/icon16.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Netflix Discord RPC",
    "default_icon": {
      "16": "assets/icon16.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "dist/background.js"
  },
  "host_permissions": [
    "*://*.netflix.com/*",
    "http://127.0.0.1/*",
    "http://localhost/*",
    "http://127.0.0.1:7777/*",
    "http://localhost:7777/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.netflix.com/*"
      ],
      "js": [
        "dist/content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
